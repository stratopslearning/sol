# Vercel Preview environment (Project → Settings → Environment Variables,
# scoped to Preview only). Do not copy production Clerk/Stripe/Neon keys.

DATABASE_URL=postgresql://USER:PASS@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
LOAD_TEST_SECRET=replace-with-at-least-16-chars
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
# Preview Clerk instance (not production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_BASE_URL=https://YOUR-PREVIEW.vercel.app
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Leave unset on the first MCQ runs; set only for exam-submit-sa
# OPENAI_API_KEY=
