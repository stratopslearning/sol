# Background jobs — copy into .env.local for local Inngest.
# Run Next and the Dev Server together:
#   npm run dev
#   npm run jobs:dev

JOBS_BACKEND=inngest

# Required only for Inngest Cloud (production). Dev Server works without these.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Dual-deploy: only ONE Vercel project should process Inngest + crons
# against a shared Neon database (typically StratOps /learning).
