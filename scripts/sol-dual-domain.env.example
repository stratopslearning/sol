# teachwithsol.com — standalone Production env (Vercel project: teachwithsol)
# Git: stratopslearning/teachwithsol  (NOT stratopslearning/sol)
# StratOps (strat-ops.net) stays on stratopslearning/sol with its own env — do not copy Clerk keys from StratOps.

NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_URL=https://app.teachwithsol.com

# Host map (middleware + lib/solHosts.ts)
NEXT_PUBLIC_SOL_MARKETING_HOST=www.teachwithsol.com
NEXT_PUBLIC_SOL_APP_HOST=app.teachwithsol.com
NEXT_PUBLIC_SOL_DOCS_HOST=docs.teachwithsol.com
NEXT_PUBLIC_SOL_TRUST_HOST=trust.teachwithsol.com

# Clerk — NEW standalone Production application (not a StratOps satellite)
# Do NOT set NEXT_PUBLIC_CLERK_IS_SATELLITE
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# Webhook endpoint in Clerk Dashboard:
#   https://app.teachwithsol.com/api/clerk/webhook

# Neon — reuse existing teachwithsol DB (already separate from StratOps)
DATABASE_URL=postgresql://sol_app:...@.../neondb?sslmode=require
DATABASE_MIGRATE_URL=postgresql://sol_migrator:...@.../neondb?sslmode=require

# Upstash — NEW Redis for this project
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# OpenAI — reuse existing key
OPENAI_API_KEY=sk-...

# Inngest — reuse existing keys; serve URL should hit teachwithsol /api/inngest
JOBS_BACKEND=inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Braintrust — NEW project/API key for teachwithsol
BRAINTRUST_API_KEY=...
BRAINTRUST_PROJECT=SOL

# Crons — teachwithsol owns Production crons (own Neon; StratOps keeps its own)
CRON_SECRET=generate-a-long-random-string

# Email (AWS SES — teachwithsol.com domain identity)
EMAIL_ENABLED=true
EMAIL_FROM=SOL <invites@teachwithsol.com>
EMAIL_REPLY_TO=support@teachwithsol.com
AWS_REGION=us-west-1

# Platform staff promotion allowlist (comma-separated emails)
PLATFORM_STAFF_GRANTORS=you@example.com

# Optional SEO / legal
# NEXT_PUBLIC_LEGAL_ENTITY=Your Co, Inc.
# NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=privacy@teachwithsol.com
# NEXT_PUBLIC_LEGAL_DMCA_EMAIL=dmca@teachwithsol.com

# Payments off until you flip the paywall
NEXT_PUBLIC_PAYMENTS_ENABLED=false
