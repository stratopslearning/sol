# Local teachwithsol multi-host map (mirrors prod: www / app / docs / trust).
# Copy these into `.env.local`, then restart `npm run dev`.
#
# Open:
#   http://www.localhost:3000      marketing
#   http://app.localhost:3000      product (login, dashboard)
#   http://docs.localhost:3000/docs
#   http://trust.localhost:3000/security
#
# Modern browsers resolve *.localhost → 127.0.0.1 (no /etc/hosts).
# Keep NEXT_PUBLIC_BASE_PATH empty so routes are not under /learning.

NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_URL=http://app.localhost:3000

# Dev DB safety (required by migrate/seed/db scripts AND Next.js boot in development).
# Only hosts from Neon project sol-knowledge-dev. Never list a production host.
# Example (pooler + direct for migrate):
DEV_DB_HOSTS=ep-shiny-sound-b7yfwq4p-pooler.c-13.us-east-1.aws.neon.tech,ep-shiny-sound-b7yfwq4p.c-13.us-east-1.aws.neon.tech
DEV_DB_BRANCH=main
# App runtime (DML, NOBYPASSRLS) — never use owner/migrator here:
# DATABASE_URL=postgresql://sol_app:...@ep-XXXX-pooler....neon.tech/neondb?sslmode=require
# Migrations only (DDL) — refuse sol_app:
# DATABASE_MIGRATE_URL=postgresql://sol_migrator:...@ep-XXXX....neon.tech/neondb?sslmode=require
# Child branch for Vitest integration/isolation suites:
# TEST_DATABASE_URL=postgresql://...@ep-XXXX-pooler....neon.tech/neondb?sslmode=require
# Confirm each migrate/seed script with --confirm-dev-db or I_CONFIRM_DEV_DB=1
# CONNECTOR_TOKEN_SECRET=  # required; never fall back to DATABASE_URL

NEXT_PUBLIC_SOL_MARKETING_HOST=www.localhost:3000
NEXT_PUBLIC_SOL_APP_HOST=app.localhost:3000
NEXT_PUBLIC_SOL_DOCS_HOST=docs.localhost:3000
NEXT_PUBLIC_SOL_TRUST_HOST=trust.localhost:3000

# Auth is on by default. Set true to hide Sign in / Sign up (Book a demo only).
NEXT_PUBLIC_SOL_DEMO_ONLY=false

# Durable jobs (run `npm run jobs:dev` alongside next)
JOBS_BACKEND=inngest
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Optional: allow Clerk redirects across local hosts
# NEXT_PUBLIC_CLERK_ALLOWED_REDIRECT_ORIGINS=http://app.localhost:3000,http://www.localhost:3000,http://localhost:3000

# Knowledge connectors (SOL-owned OAuth apps — faculty only click Connect).
# Google redirect URI (exact):
#   http://app.localhost:3000/api/professor/knowledge/connectors/oauth/callback
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# CONNECTOR_TOKEN_SECRET=
