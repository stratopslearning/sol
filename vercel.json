{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/learning/api/cron/grade-pending",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/learning/api/cron/process-materials",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/learning/api/cron/lti-roster",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/learning/api/cron/lti-passback",
      "schedule": "20 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/learning/well-known/:path*"
    },
    {
      "source": "/llms.txt",
      "destination": "/learning/llms.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/learning/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/learning/sitemap.xml"
    }
  ]
}
