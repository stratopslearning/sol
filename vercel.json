{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/grade-pending",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/process-materials",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/process-books",
      "schedule": "35 9 * * *"
    },
    {
      "path": "/api/cron/lti-roster",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/lti-passback",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/access-request-digest",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/well-known/:path*"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    }
  ]
}
